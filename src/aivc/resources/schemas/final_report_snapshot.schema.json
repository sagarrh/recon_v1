{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aivc.local/schemas/final_report_snapshot.schema.json",
  "title": "AIVC Final Report Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "idempotency_key",
    "parent_run_id",
    "client",
    "config",
    "source_bundle_ids",
    "source_bundle_checksums",
    "analysis_period",
    "status",
    "headline",
    "executive_summary",
    "executive_metrics",
    "provider_summary",
    "topic_summary",
    "query_details",
    "recon_signals",
    "recon_recommendations",
    "recon_run_history",
    "excluded_topics",
    "recon_reporting",
    "client_presentation",
    "decision_cards",
    "consolidated_actions",
    "data_quality_flags",
    "limitations",
    "methodology",
    "evidence_index",
    "generated_at",
    "checksum"
  ],
  "properties": {
    "schema_version": {"const": "1.2"},
    "report_id": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 1},
    "parent_run_id": {"type": "string", "format": "uuid"},
    "client": {"type": "object"},
    "config": {"type": "object"},
    "source_bundle_ids": {
      "type": "array",
      "minItems": 2,
      "items": {"type": "string"}
    },
    "source_bundle_checksums": {"type": "object"},
    "analysis_period": {"type": "object"},
    "status": {"enum": ["complete", "partial", "blocked", "failed"]},
    "headline": {"type": "string"},
    "executive_summary": {"type": "string"},
    "executive_metrics": {"type": "array"},
    "provider_summary": {"type": "array"},
    "topic_summary": {"type": "array"},
    "query_details": {"type": "array"},
    "recon_signals": {"type": "array"},
    "recon_recommendations": {"type": "array"},
    "recon_run_history": {"type": "array"},
    "excluded_topics": {"type": "array"},
    "recon_reporting": {"type": ["object", "null"]},
    "client_presentation": {"type": "object"},
    "decision_cards": {"type": "array"},
    "consolidated_actions": {"type": "array"},
    "data_quality_flags": {"type": "array"},
    "limitations": {"type": "array"},
    "methodology": {"type": "array"},
    "evidence_index": {"type": "array"},
    "generated_at": {"type": "string", "format": "date-time"},
    "checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
