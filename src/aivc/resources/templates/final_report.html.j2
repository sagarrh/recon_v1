<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <title>{{ report.client.canonical_name }} — AI Visibility &amp; Competitive Intelligence</title>
  <style>
    :root { --navy:#142637; --blue:#245f86; --accent:#c45b38; --paper:#f5f3ee;
      --surface:#fff; --ink:#17232d; --muted:#596976; --line:#d9dee1;
      --soft:#eaf1f5; --warn:#8a5a12; --danger:#9a352e; }
    * { box-sizing:border-box; }
    body { margin:0; background:var(--paper); color:var(--ink);
      font:15px/1.55 system-ui,-apple-system,"Segoe UI",sans-serif; }
    main { max-width:1120px; margin:auto; padding:24px 22px 72px; }
    h1,h2,h3 { font-family:Georgia,"Times New Roman",serif; line-height:1.08; }
    .cover { min-height:540px; padding:46px; border-radius:20px; color:#fff;
      background:var(--navy); display:flex; flex-direction:column; justify-content:space-between; }
    .eyebrow { text-transform:uppercase; letter-spacing:.13em; font-weight:800; font-size:.72rem; }
    .cover h1 { font-size:clamp(2.8rem,6vw,5rem); margin:16px 0; max-width:850px; }
    .cover p { color:#d5e2ed; max-width:760px; font-size:1.08rem; }
    .cover-meta { display:grid; grid-template-columns:repeat(4,1fr); gap:18px;
      border-top:1px solid #ffffff44; padding-top:20px; }
    .cover-meta small { display:block; color:#aec1cf; text-transform:uppercase;
      letter-spacing:.1em; font-size:.65rem; }
    .print { color:#fff; border:1px solid #ffffff77; background:transparent;
      border-radius:999px; padding:8px 14px; cursor:pointer; float:right; }
    section { padding-top:62px; }
    .section-head { display:grid; grid-template-columns:90px 1fr; gap:20px; margin-bottom:24px; }
    .section-head>span { color:var(--accent); font-weight:850; letter-spacing:.15em; }
    .section-head h2 { font-size:2.25rem; margin:0; }
    .card { background:var(--surface); border:1px solid var(--line); border-radius:14px;
      padding:24px; box-shadow:0 5px 20px #1426370a; }
    .metric-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(170px,1fr)); gap:12px; }
    .metric b { display:block; font:2rem Georgia,serif; margin:.4rem 0; }
    .metric small,.label { color:var(--muted); text-transform:uppercase;
      letter-spacing:.08em; font-size:.68rem; font-weight:800; }
    table { width:100%; border-collapse:collapse; background:#fff; border-radius:12px; overflow:hidden; }
    th,td { padding:12px 14px; text-align:left; border-bottom:1px solid var(--line); }
    th { color:var(--muted); font-size:.72rem; text-transform:uppercase; letter-spacing:.07em; }
    .cards { display:grid; gap:18px; }
    .card-head { display:flex; justify-content:space-between; gap:20px; align-items:start; }
    .card h3 { font-size:1.55rem; margin:.35rem 0; }
    .badge { border:1px solid var(--line); border-radius:999px; padding:5px 9px;
      white-space:nowrap; font-size:.72rem; font-weight:800; }
    .critical,.high { color:var(--danger); background:#f8e9e6; }
    .medium { color:var(--warn); background:#fbf1df; }
    .evidence-grid { display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-top:18px; }
    .evidence-grid>div { background:var(--paper); border-radius:10px; padding:15px; }
    ul,ol { padding-left:1.25rem; }
    li { margin:.45rem 0; }
    .action-list { display:grid; gap:12px; counter-reset:action; }
    .action { display:grid; grid-template-columns:38px 1fr; gap:12px; }
    .action:before { counter-increment:action; content:counter(action,decimal-leading-zero);
      font:1.2rem Georgia,serif; color:var(--accent); }
    .limitations { border-left:4px solid var(--warn); }
    footer { margin-top:60px; padding-top:16px; border-top:1px solid var(--line);
      color:var(--muted); font-size:.72rem; overflow-wrap:anywhere; }
    @media(max-width:720px) { main{padding:12px 10px 48px}.cover{padding:28px 22px}
      .cover-meta{grid-template-columns:1fr 1fr}.section-head{display:block}
      .evidence-grid{grid-template-columns:1fr}.card-head{display:block} }
    @page { margin:14mm; }
    @media print { body{background:#fff}.print{display:none}main{max-width:none;padding:0}
      .cover{min-height:250mm;border-radius:0;break-after:page}.card,table{break-inside:avoid;box-shadow:none} }
  </style>
</head>
<body>
<main>
  <header class="cover">
    <div><span class="eyebrow">Confidential client report</span>
      <button class="print" type="button" aria-label="Print or save report as PDF">Print / Save as PDF</button></div>
    <div><div class="eyebrow">{{ report.client.canonical_name }}</div>
      <h1>AI Visibility &amp;<br>Competitive Intelligence</h1>
      <p>{{ report.executive_summary }}</p></div>
    <div class="cover-meta">
      <div><small>Status</small><b>{{ report.status.value }}</b></div>
      <div><small>Profile</small><b>{{ report.config.report_profile.value }}</b></div>
      <div><small>Period start</small><b>{{ report.analysis_period.start or "Unavailable" }}</b></div>
      <div><small>Period end</small><b>{{ report.analysis_period.end or "Unavailable" }}</b></div>
    </div>
  </header>

  <section aria-labelledby="overview-title">
    <header class="section-head"><span>01</span><div><h2 id="overview-title">Executive overview</h2><p>Current AI visibility, competitive position, and material movement.</p></div></header>
    <article class="card"><p>{{ report.executive_summary }}</p></article>
    <div class="metric-grid" style="margin-top:14px">
      {% for metric in report.executive_metrics %}<article class="card metric"><small>Literal answer visibility</small><b>{{ metric.value | percent }}</b><span>{% if metric.numerator is not none and metric.denominator is not none %}{{ metric.numerator }} of {{ metric.denominator }} answers{% else %}Latest measured cohort{% endif %}</span></article>{% endfor %}
      <article class="card metric"><small>Monitored topics</small><b>{{ report.topic_summary | length }}</b><span>Current SOV snapshots</span></article>
      <article class="card metric"><small>Material priorities</small><b>{{ report.decision_cards | length }}</b><span>Passed publication checks</span></article>
      <article class="card metric"><small>Quality flags</small><b>{{ report.data_quality_flags | length }}</b><span>Disclosed below</span></article>
    </div>
  </section>

  <section aria-labelledby="topics-title">
    <header class="section-head"><span>02</span><div><h2 id="topics-title">Priority topic performance</h2><p>Client SOV, market rank, leader gap, and tracked-company context from the complete Recon reporting query.</p></div></header>
    <div class="cards">{% for topic in report.topic_summary %}<article class="card">
      <div class="card-head"><div><span class="label">As of {{ topic.as_of_week or "unavailable" }}</span><h3>{{ topic.cluster_label }}</h3></div><span class="badge">{% if topic.client_rank %}#{{ topic.client_rank }} of {{ topic.market_size }}{% else %}Unranked{% endif %}</span></div>
      <div class="metric-grid"><div class="metric"><small>Client SOV</small><b>{{ topic.current_client_sov | sov }}</b></div><div class="metric"><small>Market leader</small><b>{{ topic.leader_sov | sov }}</b><span>{{ topic.leader_name or "Unavailable" }}</span></div><div class="metric"><small>Gap to leader</small><b>{{ topic.gap_to_leader | sov }}</b></div></div>
      <h4>Company comparison</h4><table><thead><tr><th>Rank</th><th>Company</th><th>SOV</th><th>Relationship</th></tr></thead><tbody>{% for company in topic.positions %}<tr><td>{{ company.rank or "—" }}</td><td><b>{{ company.company_name }}</b></td><td>{{ company.sov | sov }}</td><td>{% if company.is_client %}Client{% elif company.is_tracked %}Tracked competitor{% else %}Market{% endif %}</td></tr>{% endfor %}</tbody></table>
      {% if report.config.effective_profile.include_full_sov_tables and topic.history %}<h4>SOV history</h4><table><thead><tr><th>Week</th><th>Company</th><th>SOV</th><th>Change</th><th>Answers</th></tr></thead><tbody>{% for point in topic.history %}<tr><td>{{ point.week_date }}</td><td>{{ point.company_name }}</td><td>{{ point.sov | sov }}</td><td>{{ point.delta_pp | points }}</td><td>{{ point.answers_analyzed or "—" }}</td></tr>{% endfor %}</tbody></table>{% endif %}
    </article>{% else %}<article class="card"><p>No reliable SOV topic snapshot was available.</p></article>{% endfor %}</div>
  </section>

  <section aria-labelledby="providers-title"><header class="section-head"><span>03</span><div><h2 id="providers-title">Provider performance</h2><p>Literal company presence in monitored answer sets—not SOV.</p></div></header><table><thead><tr><th>Provider</th><th>Literal visibility</th><th>Trend</th><th>Queries</th></tr></thead><tbody>{% for provider in report.provider_summary %}<tr><td>{{ provider.provider }}</td><td>{{ provider.current_visibility | percent }}</td><td>{{ provider.trend }}</td><td>{{ provider.query_count }}</td></tr>{% endfor %}</tbody></table></section>

  <section aria-labelledby="priorities-title"><header class="section-head"><span>04</span><div><h2 id="priorities-title">Material citation findings</h2><p>Only changes that passed identity, materiality, and evidence checks.</p></div></header><div class="cards">{% for card in report.decision_cards %}<article class="card"><div class="card-head"><div><span class="label">{{ card.classification | replace('_',' ') }}</span><h3>{{ card.title }}</h3></div><span class="badge {{ card.priority }}">{{ card.priority }}</span></div><p>{{ card.summary }}</p><div class="evidence-grid"><div><span class="label">Interpretation</span><p>{{ card.recon_evidence_summary or card.confidence_reasons[0] }}</p></div><div><span class="label">Confidence</span><p><b>{{ card.confidence }}</b> — {{ card.confidence_reasons | join(' ') }}</p></div></div>{% if card.citation_sources %}<h4>Citation-source evidence</h4><ul>{% for source in card.citation_sources %}<li><b>{{ source.domain }}</b> — {{ source.status }}{% if source.coverage_delta is not none %}; answer coverage change {{ source.coverage_delta }}{% endif %}</li>{% endfor %}</ul>{% endif %}</article>{% else %}<article class="card"><h3>No material citation movement</h3><p>The current snapshot remains useful for baseline SOV and competitor context.</p></article>{% endfor %}</div></section>

  <section aria-labelledby="recon-title"><header class="section-head"><span>05</span><div><h2 id="recon-title">Recon competitive intelligence</h2><p>Validated historical Recon movements and recommendations; NOISE rows are retained in the structured source payload but excluded from presented findings.</p></div></header>
    {% if report.recon_signals %}<table style="margin-bottom:18px"><thead><tr><th>Week</th><th>Topic</th><th>Competitor</th><th>Severity</th><th>SOV movement</th><th>Evidence</th></tr></thead><tbody>{% for signal in report.recon_signals %}<tr><td>{{ signal.week_date or "—" }}</td><td>{{ signal.cluster_name or "—" }}</td><td>{{ signal.competitor or "—" }}</td><td>{{ signal.severity or "—" }}</td><td>{{ signal.competitor_delta_pp | points }}</td><td>{{ signal.evidence_summary or "No concise evidence summary supplied." }}</td></tr>{% endfor %}</tbody></table>{% else %}<article class="card" style="margin-bottom:18px"><p>No non-noise Recon signal was available for this period.</p></article>{% endif %}
    <div class="cards">{% for recommendation in report.recon_recommendations %}<article class="card"><div class="card-head"><div><span class="label">{{ recommendation.priority or "priority" }} · {{ recommendation.confidence or "unknown confidence" }}</span><h3>{{ recommendation.cluster_name or "Competitive recommendation" }}</h3></div>{% if recommendation.competitor %}<span class="badge">{{ recommendation.competitor }}</span>{% endif %}</div><p>{{ recommendation.summary }}</p>{% if recommendation.probable_cause %}<p><b>Working hypothesis.</b> {{ recommendation.probable_cause }}</p>{% endif %}{% if recommendation.gap_analysis %}<p><b>Client gap.</b> {{ recommendation.gap_analysis }}</p>{% endif %}<h4>Recommended response</h4><ul>{% for action in recommendation.actions %}<li>{{ action }}</li>{% endfor %}</ul>{% if recommendation.timeline %}<p><small>Expected response window: {{ recommendation.timeline }}</small></p>{% endif %}</article>{% else %}<article class="card"><p>No publishable Recon recommendation survived the quality gate for this period.</p></article>{% endfor %}</div></section>

  <section aria-labelledby="actions-title"><header class="section-head"><span>06</span><div><h2 id="actions-title">Action plan</h2><p>Actions are separated from measured facts and retain their measurement signal.</p></div></header><div class="card action-list">{% for action in report.consolidated_actions %}<div class="action"><div><b>{{ action.action }}</b><p>{{ action.measurement_signal }}</p></div></div>{% else %}<p>Use the validated Recon recommendations above and reassess in the next monitoring cycle.</p>{% endfor %}</div></section>

  {% if report.config.effective_profile.include_query_details %}<section aria-labelledby="queries-title"><header class="section-head"><span>07</span><div><h2 id="queries-title">Query-level detail</h2><p>Exact monitored questions and provider-specific literal visibility.</p></div></header><table><thead><tr><th>Topic</th><th>Provider</th><th>Query</th><th>Visibility</th><th>Trend</th></tr></thead><tbody>{% for query in report.query_details %}<tr><td>{{ query.cluster_name or "Custom" }}</td><td>{{ query.provider }}</td><td>{{ query.query }}</td><td>{{ query.current_visibility | percent }}</td><td>{{ query.trend }}</td></tr>{% endfor %}</tbody></table></section>{% endif %}

  <section aria-labelledby="decisions-title"><header class="section-head"><span>08</span><div><h2 id="decisions-title">Leadership decisions</h2><p>Choices implied by the measured position—not additional unmeasured claims.</p></div></header><article class="card"><ol>{% for topic in report.topic_summary[:3] %}<li>Decide whether <b>{{ topic.cluster_label }}</b> warrants priority based on a {{ topic.gap_to_leader | sov }} gap to {{ topic.leader_name or "the market leader" }}.</li>{% endfor %}{% for card in report.decision_cards[:2] %}<li>Decide whether to resource the response to {{ card.title }}.</li>{% endfor %}</ol></article></section>

  <section aria-labelledby="limits-title"><header class="section-head"><span>09</span><div><h2 id="limits-title">Limitations and methodology</h2></div></header><article class="card limitations"><ul>{% for limitation in report.limitations %}<li>{{ limitation }}</li>{% else %}<li>No material limitations were detected.</li>{% endfor %}{% for topic in report.excluded_topics %}<li><b>Excluded source topic{% if topic.cluster_id %} {{ topic.cluster_id }}{% endif %}:</b> {{ topic.reason }}</li>{% endfor %}</ul></article>{% if report.config.effective_profile.include_data_quality_appendix %}<article class="card" style="margin-top:16px"><h3>Metric definitions</h3><dl>{% for metric in report.methodology %}<dt><b>{{ metric.display_name }}</b></dt><dd>{{ metric.definition }} Scope: {{ metric.aggregation_scope }}.</dd>{% endfor %}</dl><h3>Recon run history</h3><table><thead><tr><th>Run</th><th>Status</th><th>Sync date</th><th>Triggers</th></tr></thead><tbody>{% for run in report.recon_run_history %}<tr><td><code>{{ run.run_id }}</code></td><td>{{ run.status }}</td><td>{{ run.sync_date or "—" }}</td><td>{{ run.triggers_fired }}</td></tr>{% endfor %}</tbody></table></article>{% endif %}</section>

  {% if report.config.effective_profile.include_evidence_appendix %}<section aria-labelledby="evidence-title"><header class="section-head"><span>10</span><div><h2 id="evidence-title">Evidence appendix</h2></div></header><article class="card"><ul>{% for evidence in report.evidence_index %}<li><code>{{ evidence.evidence_id }}</code> — {{ evidence.kind }}{% if evidence.summary %}: {{ evidence.summary }}{% endif %}</li>{% endfor %}</ul></article></section>{% endif %}
  <footer>{{ report.client.canonical_name }} · Report {{ report.report_id }} · Parent run {{ report.parent_run_id }} · Snapshot {{ report.checksum }}</footer>
</main>
<script>document.querySelector(".print")?.addEventListener("click",()=>window.print());</script>
</body>
</html>
